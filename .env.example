# Copy to .env and fill in. Never commit the real .env. It is git-ignored.
#
# One OAuth client covers every account. Google Cloud Console ->
# APIs & Services -> Credentials -> Create Credentials -> OAuth client ID -> Desktop app.
# Enable the Gmail API on the same project, then run, once per account:
#
#   npm run authorize -- --account personal
#   npm run authorize -- --account jobs
#
# Each run prints the two lines to paste below, with the address it actually
# signed you in as, so a label can never end up pointing at the wrong mailbox.

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Comma-separated labels. These are the values the model passes as `account`.
GMAIL_ACCOUNTS=personal,jobs

GMAIL_ACCOUNT_PERSONAL_EMAIL=
GMAIL_ACCOUNT_PERSONAL_REFRESH_TOKEN=

GMAIL_ACCOUNT_JOBS_EMAIL=
GMAIL_ACCOUNT_JOBS_REFRESH_TOKEN=

# Optional. An account can carry its own OAuth client, for a mailbox that lives in a
# different Cloud project:
# GMAIL_ACCOUNT_JOBS_CLIENT_ID=
# GMAIL_ACCOUNT_JOBS_CLIENT_SECRET=

# Optional. `full` (default) requests gmail.modify: read, drafts, send, labels, trash.
# `readonly` requests gmail.readonly and the server registers only the read tools.
# GMAIL_SCOPE_PROFILE=full

# Optional. Sending is refused unless this is exactly `true`. With it unset or false the
# send tools are not registered at all, so the server can create drafts and nothing else.
# GMAIL_ALLOW_SEND=false

# Optional. A macOS dialog before every send, showing the account, the recipient, and the
# subject. Default on. Off it goes with GMAIL_CONFIRM_POPUP=off. While it is on and the
# dialog cannot be shown, sends are refused rather than allowed through.
# GMAIL_CONFIRM_POPUP=send

# Optional. Minutes an active-account selection stays good. Default 60. 0 means it stands
# until the server restarts.
# GMAIL_ACTIVE_TTL_MINUTES=60

# Optional. Append-only log of every call: tool, mailbox, whether that was the active one,
# and for drafts and sends the recipients and subject. Default ~/.gmail-multi-mcp/audit.jsonl.
# GMAIL_AUDIT_LOG=off
