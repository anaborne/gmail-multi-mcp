{
  "name": "gmail-multi-mcp",
  "version": "0.2.0",
  "description": "An MCP server that holds several Gmail accounts open at once. Reads follow an active mailbox you can switch, writes always name theirs, every call is logged, and a desktop dialog confirms each send.",
  "license": "MIT",
  "author": "Immanuel Anaborne <immanuel.anaborne@gmail.com>",
  "homepage": "https://github.com/anaborne/gmail-multi-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anaborne/gmail-multi-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/anaborne/gmail-multi-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "multi-account",
    "email",
    "llm",
    "claude",
    "ai-tools"
  ],
  "type": "module",
  "bin": {
    "gmail-multi-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "authorize": "node scripts/authorize.mjs",
    "accounts": "npm run build && node scripts/accounts.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "verify": "npm run build && node scripts/verify.mjs",
    "popup-test": "npm run build && node scripts/popup-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "googleapis": "^176.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
